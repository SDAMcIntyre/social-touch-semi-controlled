# Normalize line endings to LF in the repository.
# On checkout, Windows will keep LF (no conversion) since core.autocrlf is not set.
* text=auto eol=lf

# Explicitly binary — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.bmp  binary
*.tiff binary
*.ico  binary
*.svg  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.mp4  binary
*.mkv  binary
*.avi  binary
*.pkl  binary
*.npy  binary
*.npz  binary
*.pt   binary
*.pth  binary
*.so   binary
*.dll  binary
